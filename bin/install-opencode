#!/bin/bash
#
# Standalone OpenCode installation script
# Can be run independently or as part of full dotfiles setup

set -e

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

step() { echo ""; echo -e "${BLUE}➜${NC} $1"; }
success() { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }
error() { echo -e "${RED}✗${NC} $1"; exit 1; }

echo ""
echo "OpenCode Installation"
echo "========================"
echo ""

# Install OpenCode
step "Installing OpenCode CLI"
if command -v opencode &>/dev/null; then
    warn "OpenCode already installed"
else
    if command -v npm &>/dev/null; then
        npm install -g opencode-ai || warn "OpenCode installation failed"
    else
        warn "npm not found, using curl installer"
        curl -fsSL https://opencode.ai/install | bash || warn "OpenCode installation failed"
    fi
fi
success "OpenCode processed"

# Check if running from dotfiles repo
DOTFILES_DIR="$HOME/.dotfiles"
if [ ! -d "$DOTFILES_DIR" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$SCRIPT_DIR/../config/opencode/opencode.jsonc" ]; then
        DOTFILES_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
    fi
fi

# OpenCode configuration
if [ -d "$DOTFILES_DIR/config/opencode" ]; then
    step "Setting up OpenCode configuration"
    mkdir -p ~/.config/opencode

    ln -sf "$DOTFILES_DIR/config/opencode/opencode.jsonc" ~/.config/opencode/opencode.jsonc

    # Global rules. OpenCode reads ~/.config/opencode/AGENTS.md (falling back to
    # ~/.claude/CLAUDE.md), so link the same harness-neutral AGENTS.md source.
    if [ -f "$DOTFILES_DIR/config/claude/AGENTS.md" ]; then
        ln -sf "$DOTFILES_DIR/config/claude/AGENTS.md" ~/.config/opencode/AGENTS.md
    fi

    # Skills. OpenCode reads ~/.agents/skills natively, so reuse the shared
    # linker instead of symlinking the raw directory (it filters out skills that
    # need Claude-specific MCP tooling, like `ui`).
    if [ -x "$DOTFILES_DIR/bin/link-agent-skills" ]; then
        DOTFILES_DIR="$DOTFILES_DIR" "$DOTFILES_DIR/bin/link-agent-skills"
    fi

    # Agents. OpenCode discovers subagents from ~/.config/opencode/agents/*.md
    # (the filename becomes the agent name). Symlink the shared Claude agents
    # directory; OpenCode ignores the Claude-specific frontmatter fields.
    if [ -d "$DOTFILES_DIR/config/claude/agents" ]; then
        rm -rf ~/.config/opencode/agents
        ln -sf "$DOTFILES_DIR/config/claude/agents" ~/.config/opencode/agents
    fi

    success "OpenCode configured"
else
    warn "Dotfiles directory not found, skipping configuration"
    echo "  To set up configuration later, clone dotfiles to ~/.dotfiles"
fi

# Done
echo ""
success "OpenCode setup complete!"
echo ""
step "Next steps:"
if [ ! -d "$DOTFILES_DIR/config/opencode" ]; then
    echo "  • Clone dotfiles for custom configuration:"
    echo "    git clone https://github.com/ndeblauw/dotfiles.git ~/.dotfiles"
    echo "    ~/.dotfiles/bin/install-opencode"
    echo ""
fi
echo "  • Start using: opencode"
echo ""
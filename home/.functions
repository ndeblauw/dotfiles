# Run tests
function p() {
   if [ -f vendor/bin/pest ]; then
      vendor/bin/pest "$@"
   else
      vendor/bin/phpunit "$@"
   fi
}

function pf() {
   if [ -f vendor/bin/pest ]; then
      vendor/bin/pest --filter "$@"
   else
      vendor/bin/phpunit --filter "$@"
   fi
}

# Create a new directory and enter it
function mkd() {
   mkdir -p "$@" && cd "$@"
}

# All the dig info
function digga() {
	dig +nocmd "$1" any +multiline +noall +answer
}

function removehost() {
   ssh-keygen -R "$1"
}

#  Commit everything
function commit() {
  commitMessage="$*"

  git add .

  if [ "$commitMessage" = "" ]; then
     # Start spinner in background (suppress job control messages)
     {
       spinner="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
       while true; do
         for (( i=0; i<${#spinner}; i++ )); do
           printf "\r${spinner:$i:1} Generating commit message..."
           sleep 0.1
         done
       done
     } &!
     spinner_pid=$!

     # Cleanup function for interrupt
     cleanup() {
       { kill $spinner_pid; wait $spinner_pid; } 2>/dev/null
       printf "\r\033[K"
       trap - INT
       return 1
     }
     trap cleanup INT

     # Get diff with size limit, include stat summary for context
     diff_input=$(echo "=== Summary ===" && git diff --cached --stat && echo -e "\n=== Diff (truncated if large) ===" && git diff --cached | head -c 50000)
     commitMessage=$(echo "$diff_input" | claude -p --no-session-persistence "Write a single-line commit message for this diff. Output ONLY the message, no quotes, no explanation, no markdown.")

     # Stop spinner and clear line
     trap - INT
     { kill $spinner_pid; wait $spinner_pid; } 2>/dev/null
     printf "\r\033[K"

     git commit -m "$commitMessage"
     return
  fi

  eval "git commit -a -m '${commitMessage}'"
}

function db() {
    case "$1" in
        refresh)
            mysql -uroot -e "drop database $2; create database $2"
            ;;
        create)
            mysql -uroot -e "create database $2"
            ;;
        drop)
            mysql -uroot -e "drop database $2"
            ;;
        list)
            mysql -uroot -e "show databases" | sed 's/[|[:space:]]//g'
            ;;
        *)
            echo "Usage: db {refresh|create|drop|list} [database_name]"
            return 1
            ;;
    esac
}

# Read a single value from the project's .env without sourcing it.
function _db_import_env() {
    local key="$1" line value
    line=$(command grep -E "^[[:space:]]*(export[[:space:]]+)?${key}=" .env | tail -n 1) || return 0
    value=${line#*=}
    value=${value%$'\r'}
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    if [[ $value == \"*\" ]]; then value=${value#\"}; value=${value%\"}; fi
    if [[ $value == \'*\' ]]; then value=${value#\'}; value=${value%\'}; fi
    print -r -- "$value"
}

# Import a SQL dump into the current Laravel project's MySQL database.
# Reads DB_* from .env and picks dumps from ~/Sql dumps whose filename contains
# the database name, newest first. With several matches it shows a menu and
# preselects the most recent one.
#
#   dbimport              # choose from the menu
#   dbimport path/to.sql  # import a specific file
#   dbimport -y           # skip the confirmation prompt
function dbimport() {
    local assume_yes=0 dump="" arg
    for arg in "$@"; do
        case "$arg" in
            -y|--yes) assume_yes=1 ;;
            *) dump="$arg" ;;
        esac
    done

    if [[ ! -f artisan || ! -f .env ]]; then
        print -u2 "dbimport: run this from the root of a Laravel project (no artisan or .env here)."
        return 1
    fi

    local connection db host port user pass
    connection=$(_db_import_env DB_CONNECTION)
    db=$(_db_import_env DB_DATABASE)
    host=$(_db_import_env DB_HOST)
    port=$(_db_import_env DB_PORT)
    user=$(_db_import_env DB_USERNAME)
    pass=$(_db_import_env DB_PASSWORD)

    connection=${connection:-mysql}
    host=${host:-127.0.0.1}
    port=${port:-3306}
    user=${user:-root}

    if [[ $connection != (mysql|mariadb) ]]; then
        print -u2 "dbimport: only MySQL/MariaDB is supported, DB_CONNECTION is '$connection'."
        return 1
    fi
    if [[ -z $db ]]; then
        print -u2 "dbimport: DB_DATABASE is empty in .env."
        return 1
    fi

    if [[ -z $dump ]]; then
        local dump_dir="$HOME/Sql dumps"
        if [[ ! -d $dump_dir ]]; then
            print -u2 "dbimport: dump directory '$dump_dir' does not exist."
            return 1
        fi

        local -a matches sorted
        matches=("${(@f)$(find "$dump_dir" -maxdepth 1 -type f ! -name '.*' -iname "*${db}*" -print)}")
        matches=("${(@)matches:#}")

        if (( ${#matches} == 0 )); then
            print -u2 "dbimport: no dump in '$dump_dir' has '$db' in its filename."
            return 1
        fi

        # Newest first: use the YYYY-MM-DD date in the filename when there is
        # one, otherwise the file's modification time.
        local file base key
        local -a entries
        for file in "${matches[@]}"; do
            base=${file:t}
            if [[ $base =~ ([0-9]{4})-([0-9]{2})-([0-9]{2}) ]]; then
                key="${match[1]}${match[2]}${match[3]}"
            else
                key=$(stat -f %Sm -t %Y%m%d "$file")
            fi
            entries+=("${key}"$'\t'"${file}")
        done
        sorted=("${(@f)$(printf '%s\n' "${entries[@]}" | sort -r | cut -f2-)}")
        matches=("${sorted[@]}")

        if (( ${#matches} == 1 )); then
            dump=${matches[1]}
            print "Using ${dump:t}"
        else
            print "Dumps for '$db' (newest first):"
            local i
            for i in {1..${#matches}}; do
                print "  $i) ${matches[i]:t}"
            done
            print -n "Pick one [1-${#matches}, default 1]: "
            local choice
            read -r choice
            choice=${choice:-1}
            if ! [[ $choice =~ '^[0-9]+$' ]] || (( choice < 1 || choice > ${#matches} )); then
                print -u2 "dbimport: '$choice' is not a valid choice."
                return 1
            fi
            dump=${matches[choice]}
        fi
    elif [[ ! -f $dump ]]; then
        print -u2 "dbimport: '$dump' does not exist."
        return 1
    fi

    print "Import ${dump:t} into '$db' on $host:$port as $user"
    if (( ! assume_yes )); then
        print -n "Continue? [y/N] "
        local answer
        read -r answer
        if [[ $answer != (y|Y|yes|YES) ]]; then
            print "Aborted."
            return 1
        fi
    fi

    local -a mysql_args
    mysql_args=(-h "$host" -P "$port" -u "$user")
    local -x MYSQL_PWD="$pass"

    mysql "${mysql_args[@]}" -e "CREATE DATABASE IF NOT EXISTS \`$db\`" || {
        print -u2 "dbimport: could not create or reach database '$db'."
        return 1
    }

    print "Importing..."
    local start=$SECONDS
    mysql "${mysql_args[@]}" "$db" < "$dump" || {
        print -u2 "dbimport: import failed."
        return 1
    }
    print "Imported ${dump:t} into '$db' in $(( SECONDS - start ))s."
}

function scheduler() {
   while :; do
      php artisan schedule:run
      echo "Sleeping 60 seconds..."
      sleep 60
   done
}

function claude-yolo() {
  claude --dangerously-skip-permissions "$@"
}

function git-prune-local() {
  git fetch -p && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -D
}

function clone() {
  gh repo clone "$1" "${@:2}"
}
